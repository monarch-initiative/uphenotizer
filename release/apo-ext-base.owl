<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/monarch-initiative/uphenotizer/release/apo-ext-base.owl#"
     xml:base="https://w3id.org/monarch-initiative/uphenotizer/release/apo-ext-base.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:uphenotizer="https://w3id.org/monarch-initiative/uphenotizer#">
    <owl:Ontology rdf:about="https://w3id.org/monarch-initiative/uphenotizer/release/apo-ext-base.owl">
        <owl:versionIRI rdf:resource="https://w3id.org/monarch-initiative/uphenotizer/releases/2026-11-01/apo-ext-base.owl"/>
        <terms:title>APO-ext: SGD phenotypes pre-composed from Alliance annotations</terms:title>
        <owl:versionInfo>2026-11-01</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/IAO_0000115 -->

    <owl:AnnotationProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000115"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#SubsetProperty -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#hasExactSynonym -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#inSubset -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#inSubset"/>
    


    <!-- https://w3id.org/monarch-initiative/uphenotizer#fly_phenotype -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/monarch-initiative/uphenotizer#fly_phenotype">
        <rdfs:comment>Drosophila melanogaster phenotypes pre-composed from FlyBase annotations (DPO-ext).</rdfs:comment>
        <rdfs:label>fly phenotype</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


    <!-- https://w3id.org/monarch-initiative/uphenotizer#yeast_phenotype -->

    <owl:AnnotationProperty rdf:about="https://w3id.org/monarch-initiative/uphenotizer#yeast_phenotype">
        <rdfs:comment>Saccharomyces cerevisiae phenotypes pre-composed from SGD annotations (APO-ext).</rdfs:comment>
        <rdfs:label>yeast phenotype</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/RO_0002162 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002162">
        <rdfs:label>in taxon</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/UPHENO_0000001 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/UPHENO_0000001">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/UPHENO_0000003"/>
        <rdfs:label>phenotype affects entity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.obolibrary.org/obo/UPHENO_0000003 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/UPHENO_0000003">
        <rdfs:label>phenotype is associated with entity</rdfs:label>
    </owl:ObjectProperty>
    


